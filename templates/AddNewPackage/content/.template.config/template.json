{
    "$schema": "https://json.schemastore.org/template",
    //
    // TEMPLATE METADATA - these are used primarily for display in template galleries and search results, but can also be used to conditionally include/exclude content in the template
    "author": "Val Melamed",
    "classifications": [
        "vm2",
        "Package"
    ],
    "identity": "vm2.Templates.AddNewPackage",
    "groupIdentity": "vm2.Templates",
    "name": "vm2 NuGet Package Solution",
    "shortName": "vm2pkg",
    "sourceName": "MyPackage",
    "preferNameDirectory": true,
    // *TODO*  the solution file and other artifacts have vm2. hardcoded as a prefix: vm2.MyPackage.slnx, vm2.MyPackage.csproj,
    // etc. When a user passes --name vm2.test1, MyPackage → vm2.test1 everywhere, so vm2.MyPackage → vm2.vm2.test1.
    // We get a double prefix. For now the solution is to pass `--name MyPackage --output vm2.MyPackage`.
    // Ideally the template should be smart enough to detect and avoid double prefixing.
    "tags": {
        "language": "C#",
        "type": "project"
    },
    // One "Display manual instructions" post-action (AC1156F7-...) per setup step: 'manualInstructions' picks only ONE
    // of its entries (by condition), so it cannot split long text -- several post-actions can. Each prints its
    // description, its instructions, and (when 'args' is defined) the "Actual command" line, ready to copy.
    // Keep the texts short and point to vm2.DevOps/docs/CONFIGURATION.md instead of listing the secrets here: a copied
    // list drifts (it already did once).
    "postActions": [
        {
            "id": "prerequisites",
            "description": "Prerequisites",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "manualInstructions": [
                {
                    "text": "Clone vm2.DevOps and vm2.Templates into $VM2_REPOS; both must be up to date with origin/main."
                }
            ]
        },
        {
            "id": "setup-repo",
            "description": "Create and configure the GitHub repository",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "manualInstructions": [
                {
                    "text": "Run setup-repo.sh in the new repository: it creates the local and remote repositories, applies the vm2 settings, permissions, and branch rules, and sets the variables and secrets. See vm2.DevOps/docs/CONFIGURATION.md for every secret; create a new CODECOV_TOKEN for this repository only."
                }
            ],
            "args": {
                "executable": "$VM2_REPOS/vm2.DevOps/scripts/bash/src/setup-repo.sh",
                "args": "--repo-name vm2.MyPackage --interactive-vars --interactive-secrets"
            }
        },
        {
            "id": "diff-shared",
            "description": "Sync the shared files with the latest SoT",
            "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
            "manualInstructions": [
                {
                    "text": "The template may be older than vm2.Templates on main: compare and update the shared files from the new repository's directory."
                }
            ],
            "args": {
                "executable": "$VM2_REPOS/vm2.DevOps/scripts/bash/src/diff-shared.sh",
                "args": ""
            }
        }
    ],
    // "constraints": {
    // },
    //
    // TEMPLATE SOURCE files configuration - these are the files that will be copied and processed to create the new project/solution. You can specify include/exclude patterns, conditional inclusion based on symbols, and renaming rules.
    "sources": [
        {
            "modifiers": [
                {
                    "exclude": [
                        "licenses/**",
                        "diff-shared.config.json",
                        "**/packages.lock.json",
                        "**/bin/**",
                        "**/obj/**"
                    ]
                },
                {
                    "condition": "license == 'MIT'",
                    "include": [
                        "licenses/MIT.txt"
                    ],
                    "rename": {
                        "licenses/MIT.txt": "LICENSE"
                    }
                },
                {
                    "condition": "license == 'Apache-2.0'",
                    "include": [
                        "licenses/Apache-2.0.txt"
                    ],
                    "rename": {
                        "licenses/Apache-2.0.txt": "LICENSE"
                    }
                },
                {
                    "condition": "license == 'BSD-3'",
                    "include": [
                        "licenses/BSD-3-Clause.txt"
                    ],
                    "rename": {
                        "licenses/BSD-3-Clause.txt": "LICENSE"
                    }
                },
                {
                    "condition": "!(includeTests)",
                    "exclude": [
                        "tests/**"
                    ]
                },
                {
                    "condition": "!(includeBenchmarks)",
                    "exclude": [
                        "benchmarks/**"
                    ]
                },
                {
                    "condition": "!(includeExamples)",
                    "exclude": [
                        "examples/**"
                    ]
                },
                {
                    "condition": "!(includeDocs)",
                    "exclude": [
                        "docs/**"
                    ]
                }
            ]
        }
    ],
    // "guids": [
    //     "MyPackage.csproj",
    //     "MyPackage.Tests.csproj"
    // ],
    "symbols": {
        "initialVersion": {
            "type": "parameter",
            "datatype": "string",
            "description": "Initial package version",
            "defaultValue": "0.0.0",
            "replaces": "{{initialVersion}}"
        },
        "license": {
            "type": "parameter",
            "datatype": "choice",
            "description": "License for the project",
            "defaultValue": "MIT",
            "replaces": "{{license}}",
            "choices": [
                {
                    "choice": "MIT",
                    "description": "MIT License"
                },
                {
                    "choice": "Apache-2.0",
                    "description": "Apache License 2.0"
                },
                {
                    "choice": "BSD-3",
                    "description": "BSD 3-Clause License"
                }
            ]
        },
        "includeTests": {
            "type": "parameter",
            "datatype": "bool",
            "description": "Include test project",
            "defaultValue": "true"
        },
        "includeBenchmarks": {
            "type": "parameter",
            "datatype": "bool",
            "description": "Include benchmarks project",
            "defaultValue": "true"
        },
        "includePackages": {
            "type": "parameter",
            "datatype": "bool",
            "description": "Include packable project",
            "defaultValue": "true"
        },
        "includeExamples": {
            "type": "parameter",
            "datatype": "bool",
            "description": "Include examples folder",
            "defaultValue": "true"
        },
        "includeDocs": {
            "type": "parameter",
            "datatype": "bool",
            "description": "Include docs folder",
            "defaultValue": "true"
        },
        "repositoryOrg": {
            "type": "parameter",
            "datatype": "string",
            "description": "GitHub organization/user",
            "defaultValue": "vmelamed",
            "replaces": "{{repositoryOrg}}"
        }
    },
    // "forms": [
    //     {
    //         "name": "Package Information",
    //         "fields": [
    //             {
    //                 "name": "initialVersion"
    //             },
    //             {
    //                 "name": "license"
    //             },
    //             {
    //                 "name": "includeBenchmarks"
    //             },
    //             {
    //                 "name": "includeExamples"
    //             },
    //             {
    //                 "name": "includeDocs"
    //             },
    //             {
    //                 "name": "repositoryOrg"
    //             }
    //         ]
    //     }
    // ],
    //
    // OUTPUT MANAGEMENT - specify the primary outputs of the template, which are the files that will be generated and can be
    // used for post-processing actions. You can also specify custom output modifiers here if needed.
    "primaryOutputs": [
        {
            "path": "src/MyPackage/MyPackage.csproj"
        },
        {
            "condition": "(includeTests)",
            "path": "tests/MyPackage.Tests/MyPackage.Tests.csproj"
        },
        {
            "condition": "(includeBenchmarks)",
            "path": "benchmarks/MyPackage.Benchmarks/MyPackage.Benchmarks.csproj"
        },
        {
            "condition": "(includeDocs)",
            "path": "docs/README.md"
        },
        {
            "condition": "(includeExamples)",
            "path": "examples/Program.cs"
        },
        {
            "condition": "(includePackages)",
            "path": "src/MyPackage/MyPackage.csproj"
        }
    ],
    "specialCustomOperations": {
        "**/*.yaml": {
            "operations": [
                {
                    "type": "conditional",
                    "configuration": {
                        "if": [
                            "#if"
                        ],
                        "else": [
                            "#else"
                        ],
                        "elseif": [
                            "#elseif"
                        ],
                        "endif": [
                            "#endif"
                        ],
                        "evaluator": "C++",
                        "trim": true,
                        "wholeLine": true
                    }
                }
            ]
        },
        "**/*.yml": {
            "operations": [
                {
                    "type": "conditional",
                    "configuration": {
                        "if": [
                            "#if"
                        ],
                        "else": [
                            "#else"
                        ],
                        "elseif": [
                            "#elseif"
                        ],
                        "endif": [
                            "#endif"
                        ],
                        "evaluator": "C++",
                        "trim": true,
                        "wholeLine": true
                    }
                }
            ]
        }
    }
}
