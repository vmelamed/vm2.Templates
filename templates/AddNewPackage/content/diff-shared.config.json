{
    "$schema": "diff-shared.config.schema.json",
    "diff": {
        "tool": "delta",
        "command": "delta --side-by-side --line-numbers --paging never \"$LOCAL\" \"$REMOTE\""
    },
    "merge": {
        "tool": "code",
        "command": "code --new-window --wait --diff \"$REMOTE\" \"$LOCAL\" \"$REMOTE\" \"$LOCAL\""
    },
    "files": [
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/copilot-instructions.md",
            "targetFile": "${target_repo_path}/.github/copilot-instructions.md",
            "action": "copy shared"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/CONVENTIONS.md",
            "targetFile": "${target_repo_path}/.github/CONVENTIONS.md",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/PULL_REQUEST_TEMPLATE.md",
            "targetFile": "${target_repo_path}/.github/PULL_REQUEST_TEMPLATE.md",
            "action": "ask to merge"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/dependabot.yml",
            "targetFile": "${target_repo_path}/.github/dependabot.yml",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/workflows/CI.yaml",
            "targetFile": "${target_repo_path}/.github/workflows/CI.yaml",
            "action": "copy shared"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/workflows/Prerelease.yaml",
            "targetFile": "${target_repo_path}/.github/workflows/Prerelease.yaml",
            "action": "copy shared"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/workflows/Release.yaml",
            "targetFile": "${target_repo_path}/.github/workflows/Release.yaml",
            "action": "copy shared"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/workflows/ClearCache.yaml",
            "targetFile": "${target_repo_path}/.github/workflows/ClearCache.yaml",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/workflows/RefreshLockFiles.yaml",
            "targetFile": "${target_repo_path}/.github/workflows/RefreshLockFiles.yaml",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/workflows/AutoMerge.yaml",
            "targetFile": "${target_repo_path}/.github/workflows/AutoMerge.yaml",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.github/workflows/RebuildBenchHistory.yaml",
            "targetFile": "${target_repo_path}/.github/workflows/RebuildBenchHistory.yaml",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/vm2.DevOps/scripts/bash/src/diff-shared.custom.schema.json",
            "targetFile": "${target_repo_path}/diff-shared.custom.schema.json",
            "action": "ask to copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/Directory.Solution.props",
            "targetFile": "${target_repo_path}/Directory.Solution.props",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/Directory.Build.props",
            "targetFile": "${target_repo_path}/Directory.Build.props",
            "action": "copy shared"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/Directory.Packages.props",
            "targetFile": "${target_repo_path}/Directory.Packages.props",
            "action": "copy shared"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.editorconfig",
            "targetFile": "${target_repo_path}/.editorconfig",
            "action": "merge or copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.gitattributes",
            "targetFile": "${target_repo_path}/.gitattributes",
            "action": "merge or copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/.gitignore",
            "targetFile": "${target_repo_path}/.gitignore",
            "action": "merge or copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/codecov.yaml",
            "targetFile": "${target_repo_path}/codecov.yaml",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/coverage.settings.xml",
            "targetFile": "${target_repo_path}/coverage.settings.xml",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/global.json",
