            "targetFile": "${target_repo_path}/NuGet.config",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/testconfig.json",
            "targetFile": "${target_repo_path}/testconfig.json",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/changelog/cliff.prerelease.toml",
            "targetFile": "${target_repo_path}/changelog/cliff.prerelease.toml",
            "action": "copy"
        },
        {
            "sourceFile": "${vm2_repos}/${vm2_sot_shared}/changelog/cliff.release-header.toml",
            "targetFile": "${target_repo_path}/changelog/cliff.release-header.toml",
            "action": "copy"
        }
    ]
}
